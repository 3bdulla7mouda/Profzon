    border-color: #00ff88;
}

.login-btn {
    width: 100%;
    padding: 12px;
    background: #00ff88;
    border: none;
    border-radius: 8px;
    color: #000;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.login-btn:hover {
    background: #00cc6e;
    box-shadow: 0 0 15px #00ff88;
}

.switch-text {
    color: #888;
    margin-top: 15px;
    font-size: 0.9em;

   <script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
  import { getFirestore, collection, addDoc } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

  // إعدادات مشروعك بروفزون
  const firebaseConfig = {
    apiKey: "AIzaSyALdyY3rvNsQI9UVue6BUNdU0EhR-FSdks",
    authDomain: "profzon-384de.firebaseapp.com",
    projectId: "profzon-384de",
    storageBucket: "profzon-384de.firebasestorage.app",
    messagingSenderId: "611549560606",
    appId: "1:611549560606:web:d331008d3534aca157130f"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  // مسك الفورم (تأكد أن الـ class هو login-form كما في تصاميمك)
  const signupForm = document.querySelector('.login-form');

  signupForm.addEventListener('submit', async (e) => {
    e.preventDefault(); // منع الصفحة من الريفريش

    // سحب البيانات من الخانات الأربعة
    const name = signupForm.querySelectorAll('input')[0].value;  // اسم المستخدم
    const email = signupForm.querySelectorAll('input')[1].value; // البريد
    const phone = signupForm.querySelectorAll('input')[2].value; // الهاتف
    const pass = signupForm.querySelectorAll('input')[3].value;  // كلمة المرور

    try {
      // إرسال البيانات لفايربيز
      await addDoc(collection(db, "users"), {
        userName: name,
        userEmail: email,
        userPhone: phone,
        userPass: pass,
        createdAt: new Date().toLocaleString()
      });

      // الخطوة اللي طلبتها: التحويل للصفحة الرئيسية فوراً
      window.location.href = "index.html"; 

    } catch (error) {
      console.error("Error: ", error);
      alert("حصلت مشكلة، تأكد إنك مفعل Test Mode في Firebase");
    }
  });
</script>
